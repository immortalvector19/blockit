<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlockIt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B1320</item>
        <item name="android:colorBackground">#0B1320</item>
        <item name="android:statusBarColor">#0B1320</item>
        <item name="android:navigationBarColor">#0B1320</item>
    </style>
    <style name="Theme.BlockIt.Overlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
