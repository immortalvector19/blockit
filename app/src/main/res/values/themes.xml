<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlockIt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#ECEBE6</item>
        <item name="android:colorBackground">#ECEBE6</item>
        <item name="android:statusBarColor">#ECEBE6</item>
        <item name="android:navigationBarColor">#ECEBE6</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.BlockIt.Overlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
